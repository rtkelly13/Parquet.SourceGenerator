<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Deliberately NOT part of Parquet.SourceGenertor.sln.

    Consumes Parquet.SourceGenerator.Legacy as a NuGet package built into ../../artifacts.
    Exercises Parquet.Net 4.25.0 across .NET 8, .NET 9, and .NET Framework 4.7.2.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net9.0;net472</TargetFrameworks>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>PackageConsumptionLegacy</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Parquet.SourceGenerator.Legacy" Version="$(GeneratorPackageVersion)" />
    <PackageReference Include="Parquet.Net" Version="4.25.0" />
  </ItemGroup>

</Project>
