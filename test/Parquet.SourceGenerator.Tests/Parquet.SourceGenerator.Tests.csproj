<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <RootNamespace>Parquet.SourceGenerator.Tests</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit" />
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="coverlet.collector">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
        <PackageReference Include="Parquet.Net" />
        <PackageReference Include="YamlDotNet" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Parquet.SourceGenerator.Attributes\Parquet.SourceGenerator.Attributes.csproj" />
        <!--
      ReferenceOutputAssembly stays "true" here, unlike every other consumer in the repository.
      This project unit-tests the generator's internals directly (CodeEmitter, TargetParser,
      EquatableArray, DiagnosticInfo), so it genuinely needs the assembly as a compile reference in
      addition to running it as an analyzer. Consumers only need the generated output, and use
      "false".
    -->
        <ProjectReference
            Include="..\..\src\Parquet.SourceGenerator\Parquet.SourceGenerator.csproj"
            OutputItemType="Analyzer"
            ReferenceOutputAssembly="true"
        />
        <ProjectReference
            Include="..\..\src\Parquet.SourceGenerator.Legacy\Parquet.SourceGenerator.Legacy.csproj"
            ReferenceOutputAssembly="true"
            Aliases="LegacyGenerator"
        />
        <!--
      The benchmark regression check is the one piece of the performance story that can be verified
      without running benchmarks: unit parsing, threshold arithmetic and baseline round-tripping are
      ordinary logic. Testing them here means a broken gate fails the normal CI run rather than
      being discovered the next time someone dispatches the benchmark workflow.
    -->
        <ProjectReference Include="..\..\tools\BenchmarkSummaryGenerator\BenchmarkSummaryGenerator.csproj" />
        <!--
      Same reasoning for the regression runner: mode composition, prerequisite gating, artifact
      routing and the fixture guard are ordinary logic, and a broken /regression surface should
      fail the normal test run rather than the next nightly dispatch.
    -->
        <ProjectReference Include="..\..\tools\RegressionRunner\RegressionRunner.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="GoldenFiles\**\*.cs" />
        <None Include="GoldenFiles\**\*.cs">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>
</Project>
